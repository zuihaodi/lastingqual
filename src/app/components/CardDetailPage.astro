---
import { renderRichText } from "../lib/rich-text";
import type { CmsCardItem, CmsNavItem } from "../types/content";

interface Props {
  card: CmsCardItem;
  lang: "zh" | "en";
  parentNav?: CmsNavItem | null;
}

const { card, lang, parentNav } = Astro.props as Props;
const detail = card.detail || {};
const title = detail.title || card.title || (lang === "zh" ? "详细信息" : "Details");
const summary = detail.summary || card.summary || "";
const images = detail.images || [];
const tables = detail.tables || [];
const homeLabel = lang === "zh" ? "首页" : "Home";
const homeHref = `/${lang}`;
const parentTitle = parentNav?.title?.trim() || "";
const parentHref = parentNav?.href?.trim() || "";
const focusPos = (value?: string) => value || "center center";
const imageItemClass = (count: number) => {
  if (count === 1) return "md:basis-2/3";
  if (count === 2 || count === 4) return "md:basis-[calc((100%-1.5rem)/2)]";
  return "md:basis-[calc((100%-3rem)/3)]";
};
const parseTableText = (value?: string) =>
  (value || "")
    .split(/\r?\n/)
    .map((line) => line.split("\t").map((cell) => cell.trim()))
    .filter((row) => row.some((cell) => cell.length > 0));
const tableViews = tables
  .map((table) => {
    const rows = parseTableText(table.tableText);
    const header = rows[0] || [];
    const bodyRows = rows.slice(1);
    return { ...table, header, bodyRows, columnCount: Math.max(header.length, ...bodyRows.map((row) => row.length), 1) };
  })
  .filter((table) => table.title || table.header.length > 0 || table.note);
---

<main>
  <section class="bg-[#003865] py-14 text-white">
    <div class="max-w-7xl mx-auto px-4">
      <nav class="text-sm font-semibold text-orange-200" aria-label={lang === "zh" ? "面包屑导航" : "Breadcrumb"}>
        <a href={homeHref} class="text-orange-200 no-underline hover:text-white">{homeLabel}</a>
        {parentTitle && (
          <>
            <span class="mx-2 text-orange-100/70">/</span>
            {parentHref ? (
              <a href={parentHref} class="text-orange-200 no-underline hover:text-white">{parentTitle}</a>
            ) : (
              <span>{parentTitle}</span>
            )}
          </>
        )}
      </nav>
      <h1 class="mt-3 text-4xl font-extrabold leading-tight">{title}</h1>
      {summary && <p class="mt-4 max-w-3xl text-lg text-blue-50 whitespace-pre-line">{summary}</p>}
    </div>
  </section>

  {images.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 flex flex-wrap justify-center gap-6">
        {images.map((item) => (
          <figure class:list={["basis-full border border-gray-200 rounded-lg overflow-hidden bg-white shadow-sm", imageItemClass(images.length)]}>
            {item.image && (
              <button
                type="button"
                class="block w-full aspect-[12/7] cursor-zoom-in overflow-hidden"
                data-lightbox-src={item.image}
                data-lightbox-alt={item.caption || title}
                aria-label={lang === "zh" ? "查看大图" : "View large image"}
              >
                <img src={item.image} alt={item.caption || title} class="w-full h-full object-cover" style={{ objectPosition: focusPos(item.imageFocus) }} loading="lazy" />
              </button>
            )}
            {item.caption && <figcaption class="px-4 py-3 text-sm text-gray-600">{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {detail.body && (
    <section class="py-10 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4">
        <div class="text-gray-700 leading-8" set:html={renderRichText(detail.body)}></div>
      </div>
    </section>
  )}

  {tableViews.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-5xl mx-auto px-4 space-y-10">
        {tableViews.map((table) => (
          <div>
            {table.title && <h2 class="text-2xl font-bold text-[#003865] mb-4">{table.title}</h2>}
            {table.header.length > 0 && (
              <div class="overflow-x-auto border border-blue-200 rounded-lg">
                <table class="w-full min-w-[720px] border-collapse text-sm">
                  <thead>
                    <tr class="bg-[#D90D12] text-white">
                      {Array.from({ length: table.columnCount }).map((_, idx) => (
                        <th class="border-r border-white/60 px-4 py-3 text-center font-bold last:border-r-0">
                          {table.header[idx] || ""}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {table.bodyRows.map((row) => (
                      <tr class="odd:bg-blue-50 even:bg-white">
                        {Array.from({ length: table.columnCount }).map((_, idx) => (
                          <td class:list={["border-b border-r border-blue-100 px-4 py-3 text-center text-gray-700 last:border-r-0", idx === 0 && "font-semibold text-[#003865]"]}>
                            {row[idx] || ""}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {table.note && <p class="mt-3 text-sm text-gray-600 whitespace-pre-line">{table.note}</p>}
          </div>
        ))}
      </div>
    </section>
  )}
</main>
